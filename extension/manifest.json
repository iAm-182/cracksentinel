{
  "manifest_version": 3,
  "name": "CrackSentinel Download Guard",
  "version": "1.1.0",
  "description": "Deteksi otomatis link download game berbahaya (24/7 via sentinel.breakthematrix.id) & auto-scan file/archive lokal lewat CrackSentinel.",
  "permissions": [
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://sentinel.breakthematrix.id/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CrackSentinel Download Guard",
    "default_popup": "popup.html"
  }
}
